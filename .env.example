# Discord application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Set while developing to register commands in one guild immediately.
DISCORD_GUILD_ID=

# Cloudflare Workers AI (Workers Free plan supported)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# Persistent database. Use sqlite locally; use d1 on Koyeb.
DATABASE_BACKEND=sqlite
# Required only when DATABASE_BACKEND=d1.
D1_PROXY_URL=
D1_PROXY_TOKEN=

# App runtime
DATA_DIR=./data
PORT=7860
AI_DAILY_REQUEST_LIMIT=100
AI_TIMEOUT_MS=120000
LOG_LEVEL=info

# Optional GitHub OAuth App (enable Device Flow in the OAuth App settings)
GITHUB_CLIENT_ID=
# 32-byte key encoded as 64 hex characters; required before GitHub tokens are stored.
GITHUB_TOKEN_ENCRYPTION_KEY=
