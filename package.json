{
  "name": "discord-ai-friend-jarvis",
  "version": "2.0.0",
  "description": "Privacy-aware Discord AI friend powered by DeepSeek Harness and free-tier inference",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run cloudflare:check",
    "cloudflare:types": "wrangler types --cwd workers/d1-api",
    "cloudflare:check": "tsc -p workers/d1-api/tsconfig.json --noEmit && wrangler deploy --cwd workers/d1-api --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "jszip": "^3.10.1",
    "pdf-parse": "^2.4.5"
  },
  "keywords": [
    "discord",
    "ai",
    "deepseek-harness",
    "cloudflare"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
